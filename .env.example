# Copy to .env.local and fill in. These are the ONLY variables the code reads
# (grep: `process.env` under src/). Every one of them must also be set in the
# Vercel dashboard — .env.local is local-only, and the build reads MongoDB.

# --- Required ---

# MongoDB Atlas connection string.
# Use the non-SRV (mongodb://) form if your DNS resolver drops TXT records.
# The database name is pinned in code (see MONGODB_DB), so a URI without a
# /<db> path still works.
MONGODB_URI=

# --- Optional (sensible defaults in code) ---

# Database to use. Default: "portfolio".
MONGODB_DB=

# Resend API key. Without it the contact form still stores messages, but sends
# no email. Default: unset (email skipped, logged loudly).
RESEND_API_KEY=

# Sender identity for contact emails. Must be a domain verified in Resend.
# Default: "Ahmad Sheraz <noreply@jobcraft-ai.ahmadsheraz.com>".
CONTACT_FROM_EMAIL=

# Salt for hashing sender IPs used by the contact rate limiter. Raw IPs are
# never stored. If unset, a salt is derived from MONGODB_URI — set an explicit
# random value if you ever rotate the database URI and want counts to survive.
IP_HASH_SALT=
